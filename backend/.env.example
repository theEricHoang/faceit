SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# AWS (optional for local dev if using AWS SSO)
# AWS_PROFILE=your-sso-profile
SQS_ENROLLMENT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/faceit-enrollment-queue

# Worker configuration
# Set to 0 or -1 to run the worker indefinitely (useful for local dev).
# Default (3) makes the worker exit after 3 consecutive empty polls (for scheduled ECS tasks).
# WORKER_MAX_EMPTY_POLLS=0
